rules_version = '2';

// ANTES DE DESPLEGAR ESTAS REGLAS — checklist obligatorio:
//
// 1. Migrar membresías: el aislamiento por tenant se valida contra el doc
//    /usuarios_negocios/{uid}_{negocioId} (ID determinístico). Los docs
//    creados antes de este cambio tienen ID automático: correr
//    scripts/migrate-usuarios-negocios.ts o los usuarios existentes pierden
//    acceso. createUsuarioNegocio ya crea los nuevos con ID determinístico.
//
// 2. Backfill de negocio_id en ventas_detalle (mismo script). Las queries
//    filtran negocio_id + venta_id (lib/services/ventas-detalle). El script
//    también copia el rol del usuario a la membresía.
//
// 3. Probar en el emulador (firebase emulators:start --only firestore) los
//    flujos: login/hydrate, venta, reembolso, historial, resumen y equipo.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function membershipPath(negocioId) {
      return /databases/$(database)/documents/usuarios_negocios/$(request.auth.uid + '_' + negocioId);
    }

    // Miembro activo del negocio (vía doc de membresía determinístico)
    function isMember(negocioId) {
      return isAuthenticated()
        && negocioId is string
        && exists(membershipPath(negocioId))
        && get(membershipPath(negocioId)).data.activo == true;
    }

    // Para docs que denormalizan negocio_id
    function canReadTenantDoc() {
      return isMember(resource.data.negocio_id);
    }

    function canCreateTenantDoc() {
      return isMember(request.resource.data.negocio_id);
    }

    function isAdmin(negocioId) {
      return isMember(negocioId)
        && get(membershipPath(negocioId)).data.rol == 'ADMIN';
    }

    function priceUnchanged() {
      return request.resource.data.precio_venta == resource.data.precio_venta
        && request.resource.data.precio_mayoreo == resource.data.precio_mayoreo
        && request.resource.data.costo_promedio == resource.data.costo_promedio;
    }

    // En updates el negocio_id no puede cambiar (evita mover docs de tenant)
    function tenantUnchanged() {
      return request.resource.data.negocio_id == resource.data.negocio_id;
    }

    // ── Identidad y membresías ───────────────────────────────────────────

    match /usuarios/{userId} {
      // Lectura abierta a autenticados: la app resuelve vendedores de otros
      // docs (resumen/equipo) y busca por email en el fallback de hydrate.
      // El doc solo contiene datos de perfil (nombre, email, foto, rol).
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /usuarios_negocios/{relId} {
      // El propio usuario lee sus membresías; los miembros del negocio leen
      // el equipo completo.
      allow read: if isAuthenticated()
        && (resource.data.usuario_id == request.auth.uid
          || isMember(resource.data.negocio_id));
      // Alta de miembros y cambios de rol: solo admin del negocio.
      allow create: if isAdmin(request.resource.data.negocio_id);
      allow update: if isAdmin(resource.data.negocio_id) && tenantUnchanged();
      allow delete: if false;
    }

    match /negocios/{negocioId} {
      allow read: if isMember(negocioId);
      allow write: if false; // Alta/edición de negocios: consola o backend
    }

    match /sucursales/{sucursalId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canReadTenantDoc() && tenantUnchanged();
      allow delete: if false;
    }

    // ── Catálogo ─────────────────────────────────────────────────────────

    match /productos/{productId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc()
        && request.resource.data.precio_venta is number
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad >= 0;
      allow update: if canReadTenantDoc()
        && tenantUnchanged()
        && request.resource.data.precio_venta is number
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad >= 0
        && (isAdmin(resource.data.negocio_id) || priceUnchanged());
      allow delete: if isAdmin(resource.data.negocio_id);
    }

    match /categorias/{categoriaId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canReadTenantDoc() && tenantUnchanged();
      allow delete: if false;
    }

    // ── Ventas ───────────────────────────────────────────────────────────

    match /ventas/{ventaId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc()
        && request.resource.data.total >= 0;
      // Cambios de estado (ej. reembolso) por miembros del mismo negocio
      allow update: if canReadTenantDoc() && tenantUnchanged();
      allow delete: if false;
    }

    match /ventas_detalle/{detalleId} {
      // Docs nuevos denormalizan negocio_id; los legacy se validan leyendo
      // la venta padre (cuesta 1 get por doc — migrar legacy cuando se pueda).
      allow read: if ('negocio_id' in resource.data)
        ? isMember(resource.data.negocio_id)
        : isMember(get(/databases/$(database)/documents/ventas/$(resource.data.venta_id)).data.negocio_id);
      allow create: if isMember(request.resource.data.negocio_id)
        && request.resource.data.cantidad > 0
        && request.resource.data.precio_unitario >= 0;
      allow update, delete: if false;
    }

    match /ventas_pagos/{pagoId} {
      allow read: if ('negocio_id' in resource.data)
        ? isMember(resource.data.negocio_id)
        : isMember(get(/databases/$(database)/documents/ventas/$(resource.data.venta_id)).data.negocio_id);
      allow create: if isMember(request.resource.data.negocio_id)
        && request.resource.data.metodo_pago in ['EFECTIVO', 'DEBITO', 'TRANSFERENCIA'];
      allow update, delete: if false;
    }

    match /inventario_movimientos/{movId} {
      allow read: if ('negocio_id' in resource.data)
        && isMember(resource.data.negocio_id);
      allow create: if isMember(request.resource.data.negocio_id);
      allow update, delete: if false;
    }

    match /auditoria/{entryId} {
      allow read: if isMember(resource.data.negocio_id);
      allow create: if isMember(request.resource.data.negocio_id);
      allow update, delete: if false;
    }

    // ── Default: todo cerrado ────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
